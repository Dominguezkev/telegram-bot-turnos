# Copiá este archivo como .env (en la misma carpeta que bot.py) y completá el
# token que te da @BotFather al crear el bot con /newbot.
#
# El .env está en .gitignore: nunca se sube al repo. Si ya lo subiste por error,
# regenerá el token en BotFather con /revoke (borrar el archivo no alcanza,
# queda en el historial de git).
TOKEN=123456789:AAH-token-de-ejemplo-que-te-da-BotFather
